# Google Ads API Credentials (Explorer / Test Access)
# See research/Ads-Module/docs/Multi_Phase_Implementation_Plan.md for setup instructions

GOOGLE_ADS_DEVELOPER_TOKEN="your_explorer_developer_token"
GOOGLE_ADS_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_ADS_CLIENT_SECRET="your_client_secret"
GOOGLE_ADS_REFRESH_TOKEN="your_refresh_token"
GOOGLE_ADS_LOGIN_CUSTOMER_ID="1234567890"    # 10-digit Test Manager (MCC) Account ID (no dashes)
GOOGLE_ADS_CLIENT_CUSTOMER_ID="0987654321"   # 10-digit Test Client Account ID (no dashes)
GOOGLE_ADS_USE_PROTO_PLUS=True

# Ads Module Local Configuration
ADS_MODULE_PORT=8001
ADS_MODULE_DB_URL="sqlite:///./ads_module.db"
AI_MODULE_WEBHOOK_URL="http://localhost:8000/v1/telemetry/events"
WORKSPACE_ID="tenant_dominos_qsr"
